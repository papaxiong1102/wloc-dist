#!url=https://raw.githubusercontent.com/papaxiong1102/wloc-dist/refs/heads/main/modules/wloc.module
#!name=Apple WLOC 定位修改（自有固定版）
#!desc=仅允许两个 Apple WLOC hostname；运行脚本固定到审核版本
#!author=Yu9191 Rewrite; distribution maintained by papaxiong1102
#!homepage=https://github.com/papaxiong1102/wloc-dist
#!category=Tools

[Script]
Apple WLOC = type=http-response,pattern=^https?:\/\/gs-loc(-cn)?\.apple\.com\/clls\/wloc,requires-body=1,binary-body-mode=1,max-size=0,timeout=30,script-path=https://raw.githubusercontent.com/papaxiong1102/wloc-dist/169375c17ae4d6ef444f5ec910acf4be6750640c/dist/wloc.js,argument=longitude=113.94114&latitude=22.544577&accuracy=25&logLevel=info
WLOC Settings = type=http-request,pattern=^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save,requires-body=0,max-size=0,timeout=10,script-path=https://raw.githubusercontent.com/papaxiong1102/wloc-dist/169375c17ae4d6ef444f5ec910acf4be6750640c/dist/wloc-settings.js

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com
